# Deployment image and host listener. Override the tag to pin a release or commit SHA.
POKERNODE_SERVER_IMAGE=ghcr.io/7-e1even/pokernode-server:latest
POKERNODE_WEB_IMAGE=ghcr.io/7-e1even/pokernode-web:latest
POKERNODE_POSTGRES_IMAGE=postgres:17-alpine
POKERNODE_BIND_ADDRESS=0.0.0.0
POKERNODE_PORT=8080

# Required in both deployment modes. Keep the encryption key unchanged after first use.
POKERNODE_SESSION_SECRET=replace-with-at-least-32-random-characters
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
POKERNODE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# compose.yaml: existing PostgreSQL database.
DATABASE_URL=postgres://pokernode:database-password@postgres.example:5432/pokernode?sslmode=require

# compose.postgres.yaml: bundled PostgreSQL. Use a URL-safe value such as
# the output of: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password

# Optional: comma-separated public origins used by WebSocket reverse proxies.
POKERNODE_TRUSTED_ORIGINS=

# Optional: WeChat Open Platform website application login.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://your-domain.example/api/auth/wechat/callback
