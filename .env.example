POKERNODE_ADDR=:8080
DATABASE_URL=postgres://pokernode:replace-with-database-password@postgres.example:5432/pokernode?sslmode=require
POKERNODE_SESSION_SECRET=replace-with-at-least-32-random-characters
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
POKERNODE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Optional: WeChat Open Platform website application login.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://your-domain.example/api/auth/wechat/callback
